{
  "name": "wedding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/next-local.mjs dev",
    "build": "next build",
    "start": "node scripts/next-local.mjs start",
    "lint": "eslint --cache --max-warnings=0 .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile --project=desktop",
    "test:e2e:smoke": "playwright test --project=mobile --project=desktop --grep @smoke",
    "screenshots": "PW_SERVER=dev playwright test --project=visual",
    "verify": "pnpm t:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:smoke",
    "verify:quick": "node scripts/verify-quick.mjs",
    "db:start": "node scripts/db-local.mjs start",
    "db:stop": "node scripts/db-local.mjs stop",
    "db:status": "node scripts/db-local.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:check-rls": "tsx scripts/db-check.ts rls",
    "db:counts": "tsx scripts/db-check.ts counts",
    "themes:schema": "tsx scripts/generate-theme-schema.ts",
    "agent:loop": "bash scripts/agent-loop.sh",
    "prepare": "husky",
    "agents:link": "node scripts/agents-link.mjs",
    "agents:check": "node scripts/agents-link.mjs --check",
    "plugin:build": "node scripts/plugin.mjs build",
    "plugin:install": "node scripts/plugin.mjs install",
    "wt:new": "bash scripts/worktree.sh new",
    "wt:list": "bash scripts/worktree.sh list",
    "wt:remove": "bash scripts/worktree.sh remove",
    "wt:prune": "bash scripts/worktree.sh prune",
    "t:list": "tsx scripts/tickets.ts list",
    "t:board": "tsx scripts/tickets.ts board",
    "t:next": "tsx scripts/tickets.ts next",
    "t:show": "tsx scripts/tickets.ts show",
    "t:claim": "tsx scripts/tickets.ts claim",
    "t:release": "tsx scripts/tickets.ts release",
    "t:move": "tsx scripts/tickets.ts move",
    "t:new": "tsx scripts/tickets.ts new",
    "t:pr": "tsx scripts/tickets.ts pr",
    "t:sync": "tsx scripts/tickets.ts sync",
    "t:validate": "tsx scripts/tickets.ts validate",
    "t:render": "tsx scripts/tickets.ts render",
    "check:pr-text": "node scripts/harness/commit-rules.mjs pr",
    "t:dashboard": "tsx scripts/tickets/dashboard-server.ts",
    "t:dashboard:snapshot": "tsx scripts/tickets.ts dashboard"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
