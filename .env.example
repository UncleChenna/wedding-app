# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to .env.local (`pnpm db:start` does this for you).
# The values below are the PUBLIC defaults of a local Supabase stack
# (`supabase start`). They are not secrets. Never commit real production keys.
# Application variables are validated at startup by src/modules/shared/lib/env/schema.ts.
# ─────────────────────────────────────────────────────────────────────────────

# [server, required] Postgres connection string used by Drizzle (app, migrations, seed).
# Local Supabase exposes Postgres on port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# [server, optional] Minimum log level: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# [public, required] Canonical site URL. Used to build invitation links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [public, required] Supabase API URL (Auth, Realtime). Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# [public, required] Supabase publishable key (safe in the browser; RLS protects data).
# Local value is printed by `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# CI-only inputs declared in .github/workflows/ci.yml (not application settings).
# POSTGRES_PASSWORD: postgres — disposable GitHub Actions Postgres service password.
# It matches DATABASE_URL above; never reuse this fixture password in production.
# PR_TITLE: supplied by github.event.pull_request.title to the attribution check.
# PR_BODY: supplied by github.event.pull_request.body to the attribution check.
# RUN_RATE_LIMIT_DB_TESTS: 1 enables atomic budget tests against disposable local PostgreSQL.
# RUN_ORDER_BROWSER_TESTS: 1 enables synthetic ordering fixtures and browser journeys.
# PR text is untrusted and is passed through env, never interpolated into shell code.
# These inputs are intentionally comments: do not add them to application env schema.

# [server, optional] Comma-separated exact admin emails. Empty denies all admin sign-ins.
# Configure real approved addresses privately; never use a wildcard.
ADMIN_EMAIL_ALLOWLIST=

# [server, secret, optional until staff sign-in is enabled] 32 cryptographically random
# bytes encoded as 64 lowercase hex characters. Share the secret across app instances;
# rotating it invalidates all staff sessions and device cookies. Empty disables sign-in.
STAFF_SESSION_SECRET=

# [server, secret, optional until boards go live] The Supabase project's JWT secret (Project Settings →
# JWT Keys → legacy JWT secret). It signs 10-minute Realtime tokens for signed-in staff stations (ADR 0024).
# `pnpm db:start` fills the local stack's value. Empty turns live updates off; boards fall back to refetching.
SUPABASE_JWT_SECRET=

# [server, secret, optional until order alerts are scheduled] 32 random bytes as 64 lowercase
# hex characters. The database scheduler sends it as a Bearer token to POST /api/alerts/drain
# (ADR 0022; set up with `pnpm alerts:schedule`). Empty leaves the drain route answering 503.
ALERT_DRAIN_SECRET=

# [server, secret, optional until passes are issued] Ed25519 gate pass signing key (ADR 0021).
# Generate with `pnpm gate:keygen`; store only in the deployment's secret store. Empty
# leaves pass signing unavailable and GET /api/gate-keys returns 503. Validated by
# src/modules/checkin/server/signing.ts, not the shared schema, so only that file reads it.
GATE_SIGNING_KEY_ID=
GATE_SIGNING_PRIVATE_KEY=

# [server, optional] Retired public keys still accepted while old passes circulate:
# comma-separated `kid=base64url-spki` pairs, printed by `pnpm gate:keygen`. Public, not secret.
GATE_RETIRED_PUBLIC_KEYS=

# [test only, optional] Set to 1 only against an isolated synthetic database to run
# atomic online-admission concurrency tests. CI sets this for its disposable PostgreSQL.
# RUN_ONLINE_ADMISSION_DB_TESTS=1
# RUN_SCAN_OBSERVATION_DB_TESTS=1 enables private zero-person observation tests on disposable local PostgreSQL.
