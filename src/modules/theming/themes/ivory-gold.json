{
  "$schema": "./theme.schema.json",
  "id": "ivory-gold",
  "name": "Ivory & Gold",
  "colorScheme": "light",
  "colors": {
    "background": "#FBF8F3",
    "foreground": "#241F1A",
    "surface": "#FFFFFF",
    "surface-muted": "#F4EEE4",
    "muted-foreground": "#665A50",
    "primary": "#7A5C24",
    "primary-foreground": "#FFFFFF",
    "secondary": "#EFE6D6",
    "secondary-foreground": "#3D3226",
    "accent": "#8C3B4A",
    "accent-foreground": "#FFFFFF",
    "border": "#E6DCCC",
    "input": "#8E8174",
    "ring": "#7A5C24",
    "danger": "#A12C2C",
    "danger-foreground": "#FFFFFF",
    "danger-subtle": "#FBE7E5",
    "danger-subtle-foreground": "#8A1F1F",
    "success": "#2F6B47",
    "success-foreground": "#FFFFFF",
    "success-subtle": "#E3F1E7",
    "success-subtle-foreground": "#1F5234",
    "warning": "#946000",
    "warning-foreground": "#FFFFFF",
