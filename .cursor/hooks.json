{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/hooks.mjs\" pre cursor",
        "timeout": 600
      }
    ],
    "postToolUse": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/hooks.mjs\" post cursor",
        "timeout": 600
      }
    ],
    "stop": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/hooks.mjs\" stop cursor",
        "timeout": 600,
        "loop_limit": null
      }
    ]
  }
}
