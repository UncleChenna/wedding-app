          "value": "\"event_settings\".\"retention_days\" between 1 and 3650"
        },
        "event_settings_order_limits": {
          "name": "event_settings_order_limits",
          "value": "\"event_settings\".\"max_open_orders_per_table\" between 1 and 100 and \"event_settings\".\"order_cooldown_seconds\" between 0 and 86400 and \"event_settings\".\"max_item_quantity\" between 1 and 100"
        },
        "event_settings_cutoff_timezone": {
          "name": "event_settings_cutoff_timezone",
          "value": "\"event_settings\".\"rsvp_lock_at\" is null or \"event_settings\".\"time_zone\" is not null"
        },
        "event_settings_timezone_not_blank": {
          "name": "event_settings_timezone_not_blank",
          "value": "\"event_settings\".\"time_zone\" is null or length(trim(\"event_settings\".\"time_zone\")) > 0"
