          "value": "cardinality(\"event_settings\".\"couple_names\") = 2 and array_position(\"event_settings\".\"couple_names\", null) is null and array_ndims(\"event_settings\".\"couple_names\") = 1 and length(trim(\"event_settings\".\"couple_names\"[1])) between 1 and 200 and length(trim(\"event_settings\".\"couple_names\"[2])) between 1 and 200"
