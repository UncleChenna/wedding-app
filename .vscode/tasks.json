{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ticket dashboard (local)",
      "type": "process",
      "command": "pnpm",
      "args": ["t:dashboard"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "ticket-dashboard",
        "pattern": { "regexp": "^(__never_a_diagnostic__)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting ticket dashboard",
          "endsPattern": "^Dashboard ready at"
        }
      }
    }
  ]
}
